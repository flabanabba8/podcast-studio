            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "music_path": {
                  "type": "string"
                },
                "start_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "end_ms": {
                  "type": "integer",
                  "minimum": 1
                },
                "music_db": {
                  "type": "number",
                  "minimum": -30,
                  "maximum": 0
                },
                "fade_in_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "fade_out_ms": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "music_path",
                "start_ms",
                "end_ms",
                "music_db"
              ],
              "additionalProperties": false
            }
          },
          "voice_db": {
            "type": "number",
            "minimum": -12,
            "maximum": 0
          },
          "loudness_lufs": {
            "type": "number",
            "minimum": -30,
            "maximum": -10
          },
          "allow_profile_media": {
            "type": "boolean"
          }
        },
        "required": [
          "narration_path",
          "beds"
        ],
        "additionalProperties": false
      }
    },
